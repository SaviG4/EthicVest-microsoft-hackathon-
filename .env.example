# EthicalVest AI Environment Variables Example
# Required for server-side GenAI explanations and grounded chat
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Twelve Data Market Data Provider (Demo mode works without it)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Database path (optional, defaults to backend/ethicalvest.db)
ETHICALVEST_DB_PATH=backend/ethicalvest.db

# Node Environment & Port
PORT=3000
NODE_ENV=development
